limit_req_zone $binary_remote_addr zone=tiffin_login:10m rate=10r/m;
server {
    listen 443 ssl;
    server_name 192.168.1.101 100.72.251.13;
    ssl_certificate /etc/tiffintrack/tls/server.crt;
    ssl_certificate_key /etc/tiffintrack/tls/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 1m;
    location = /auth/login {
        limit_req zone=tiffin_login burst=15 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8087;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
    location / {
        proxy_pass http://127.0.0.1:8087;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
