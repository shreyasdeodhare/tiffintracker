SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql+psycopg://tiffintrack:CHANGE_ME@host.docker.internal:5432/tiffintrack
TIFFIN_PRICE=80.00
APP_TIMEZONE=Asia/Kolkata
TRUST_PROXY=true

# Generate separate random 32+ character secrets. Never put real values in source.
WA_BRIDGE_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
WA_SESSION_KEY=replace-with-a-different-random-secret-of-at-least-32-characters

# Weekly only: Friday 14:00 Asia/Kolkata, Saturday-Friday snapshot.
# Enable in protected server configuration only after migration/deployment review.
SUMMARY_PUBLISHING_ENABLED=false
